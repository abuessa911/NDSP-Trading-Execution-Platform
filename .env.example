# M1 safety gates. These values are mandatory and must not be weakened.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
GLOBAL_KILL_SWITCH=true
BINANCE_ALLOW_WITHDRAW=false

# PostgreSQL bootstrap and role passwords; set via a secret manager.
POSTGRES_BOOTSTRAP_USER=nex_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=
NEX_APP_DB_PASSWORD=
NEX_MIGRATOR_DB_PASSWORD=

# Supply full SQLAlchemy async URLs using the roles created above.
# URL-encode reserved characters in passwords.
DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=

# Supply the real identity provider's exact values. API protected routes fail
# closed until all three OIDC values are valid and the subject is provisioned.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGORITHM=RS256
OIDC_JWKS_CACHE_SECONDS=300
OIDC_BROWSER_LOGIN_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
NEX_SESSION_ENCRYPTION_KEY=
NEX_SESSION_SECONDS=1800
# Browser login needs an approved real issuer, exact HTTPS redirects, and a
# dedicated Fernet encryption key delivered through the secret provider.
# Preview DB connections use explicitly authorized NEX_DEV_DATABASE_URL,
# NEX_DEV_MIGRATION_DATABASE_URL and NEX_DEV_REDIS_URL, never ambient managed URLs.

ENVIRONMENT=production
SECRET_PROVIDER=env
SECRETS_DIRECTORY=/run/secrets
NEX_HTTP_PORT=8080