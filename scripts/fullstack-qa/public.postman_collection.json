{
  "info": {
    "name": "NDSP and Hunter public read-only contracts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "NDSP health",
      "request": {
        "method": "GET",
        "url": "https://api.ndsp.app/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health status 200',()=>pm.response.to.have.status(200));",
              "pm.test('Health JSON object',()=>pm.expect(pm.response.json()).to.be.an('object'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Bot landing",
      "request": {
        "method": "GET",
        "url": "https://bot.ndsp.app/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Landing status 200',()=>pm.response.to.have.status(200));",
              "pm.test('HTML response',()=>pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ]
    },
    {
      "name": "NDSP private user denies anonymous",
      "request": {
        "method": "GET",
        "url": "https://my.ndsp.app/api/auth/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Anonymous access denied',()=>pm.expect(pm.response.code).to.be.oneOf([401,403]));"
            ]
          }
        }
      ]
    }
  ]
}