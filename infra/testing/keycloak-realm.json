{
  "realm": "nex-m1-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 600,
  "ssoSessionMaxLifespan": 1800,
  "clients": [{
    "clientId": "nex-m1-browser",
    "name": "NEX isolated M1 browser test",
    "enabled": true,
    "publicClient": true,
    "standardFlowEnabled": true,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": false,
    "redirectUris": ["https://localhost:18443/api/v1/auth/callback"],
    "webOrigins": ["https://localhost:18443"],
    "protocolMappers": [{
      "name": "NEX test access-token audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "included.client.audience": "nex-m1-browser",
        "id.token.claim": "false",
        "access.token.claim": "true"
      }
    }],
    "attributes": {
      "pkce.code.challenge.method": "S256",
      "post.logout.redirect.uris": "https://localhost:18443/"
    }
  }],
  "users": [{
    "id": "22222222-2222-4222-8222-222222222201",
    "username": "nex-test-user",
    "email": "user@nex.example.test",
    "emailVerified": true,
    "enabled": true,
    "firstName": "Synthetic",
    "lastName": "NEX Test",
    "credentials": []
  }]
}